    {
      "id": "faq.privacy",
      "topic": "privacy",
      "keywords": ["privacy", "data", "do you store", "safe", "records", "தனியுரிமை"],
      "question": { "en": "What can IRUSHY see about me?", "ta": "IRUSHY \u0b8e\u0ba9\u0bcd\u0ba9\u0bc8\u0baa\u0bcd \u0baa\u0bb1\u0bcd\u0bb1\u0bbf \u0b8e\u0ba9\u0bcd\u0ba9 \u0baa\u0bbe\u0bb0\u0bcd\u0b95\u0bcd\u0b95 \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bc1\u0bae\u0bbe?" },
      "answer": {
        "en": "I cannot open student or teacher records, marks or logins, and I do not store your chat. Please do not type personal details such as your exam number, phone number or password. If you need a record changed, contact your teacher or the web admin.",
