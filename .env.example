# ---------------------------------------------------------------------------
# IRUSHY - environment template
# Copy to `.env` and fill in real values LOCALLY. Never commit `.env`.
#   cp .env.example .env
# The real `.env` file is ignored by .gitignore.
# ---------------------------------------------------------------------------

# ---- APInex provider (server-side only) -----------------------------------
# Base URL of the APInex OpenAI-compatible API.
APINEX_BASE_URL=https://api.apinex.bond/v1

# EXACT model id. Kept configurable on purpose.
# Verified present on the APInex free group (checked against the public model
# list): free/gemini-3.8-flash  ->  free tier, 1M context, 5 RPM.
# IRUSHY never silently changes this to a paid model. If this model is
# unavailable the request fails loudly (see IRUSHY_ALLOW_MODEL_FALLBACK).
APINEX_MODEL=free/gemini-3.8-flash

# Your APInex key (starts with sk-apx...). Server-side ONLY.
# Leave the placeholder to run IRUSHY in "not connected" mode.
APINEX_API_KEY=sk-apx-REPLACE_ME

# Guard rail: must stay `false`. When false, if APINEX_MODEL is unreachable
# IRUSHY reports the error instead of spending money on another model.
IRUSHY_ALLOW_MODEL_FALLBACK=false

# Optional: only needed if you ever set IRUSHY_ALLOW_MODEL_FALLBACK=true.
# APINEX_FALLBACK_MODEL=free/deepseek-v4.1-flash

# ---- Runtime --------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# Public origin of the website that embeds the widget (CORS allow-list).
# Comma separated. Keep the live site's origin so the widget works once deployed.
IRUSHY_ALLOWED_ORIGINS=https://tnhhsscta.com,https://www.tnhhsscta.com,http://localhost:8787

# Secret used to sign IRUSHY session cookies (role/permission proof).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty, a random per-boot secret is generated (sessions reset on restart).
IRUSHY_SESSION_SECRET=

# ---- Limits, timeouts, retries -------------------------------------------
IRUSHY_MAX_OUTPUT_TOKENS=700        # hard cap on model output tokens
IRUSHY_MAX_INPUT_CHARS=2000         # max characters accepted per user message
IRUSHY_MAX_HISTORY_MESSAGES=8       # bounded conversation history sent upstream
IRUSHY_MAX_HISTORY_CHARS=6000
IRUSHY_REQUEST_TIMEOUT_MS=30000     # per provider call
IRUSHY_MAX_PROVIDER_RETRIES=1       # bounded retry for 429/502/503 only
IRUSHY_PROVIDER_RPM=5               # matches the APInex free tier (5 RPM)
IRUSHY_RATE_LIMIT_MAX=20            # client requests per window per IP
IRUSHY_RATE_LIMIT_WINDOW_MS=300000
IRUSHY_MAX_CONCURRENT=2             # in-flight provider calls
IRUSHY_BODY_LIMIT_KB=32

# ---- Feature switches -----------------------------------------------------
# Web browsing is OFF by default. When true, IRUSHY may call
# /v1/tools/web/search on APInex for the homepage assistant only.
IRUSHY_ENABLE_WEB_SEARCH=false

# Sample content lives in data/sample/*.json and is ALWAYS labelled in the UI
# and in the API response. Default: on outside production, off in production.
# Sample content is never mixed into the "approved" bank.
IRUSHY_ALLOW_SAMPLE_CONTENT=true

# Shared secret with the test backend (the ASP/DB side) for verifying that an
# assessed test has really been completed and returned. The widget can never
# assert this itself. While this is empty, IRUSHY treats every assessment as
# still active and declines to give answers - which is the safe default.
#   token = base64url(JSON({studentRef, testId, status, completedAt})) + "." +
#           base64url(HMAC-SHA256(body, this secret))
IRUSHY_ASSESSMENT_SECRET=

# Student results retrieval needs authenticated, server-enforced
# teacher -> student permissions (sign-in, a per-student permission check and
# an audit record). None of that exists yet, so IRUSHY reports results access
# as UNAVAILABLE in every response and returns HTTP 503 - it never simulates a
# record. Even with this flag set to true the endpoint stays unavailable until
# a real permission source is implemented; see docs/STATUS.md.
IRUSHY_ENABLE_STUDENT_RESULTS=false

# Demo/teacher sign-in used ONLY for local permission testing.
# Leave false in production: there is no real teacher account store yet.
IRUSHY_ENABLE_DEMO_LOGIN=false
IRUSHY_DEMO_TEACHER_USER=
IRUSHY_DEMO_TEACHER_PASS=

# Transcripts are NOT stored by default. When true, only redacted,
# non-identifying operational counters are logged (never message bodies).
IRUSHY_LOG_LEVEL=info
IRUSHY_LOG_MESSAGE_BODIES=false
