# ---------------------------------------------------------------------------
# IRUSHY - environment template
#
# You do NOT need this file. `npm install && npm start` works without it:
# the default engine is IRUSHY's own local engine, which needs no key, no
# account and no network.
#
# Copy it to `.env` only to change a default:   cp .env.example .env
# The real `.env` is ignored by .gitignore. Never commit it.
# ---------------------------------------------------------------------------

# ---- Engine ----------------------------------------------------------------
# local  (default)  IRUSHY's own engine: no key, no account, no network.
# apinex (optional) the APInex gateway; needs APINEX_API_KEY further down.
# ollama (optional) a model on this machine via Ollama; needs OLLAMA_MODEL
#                   further down.
IRUSHY_ENGINE=local

# Safe debug field: when a chat request sends "debug": true, meta.debug shows
# the intent, the rule that fired, the topic, the phrase variants, the seed and
# the data ids used. It never contains message text or secrets.
IRUSHY_ENGINE_DEBUG=true

# ---- Runtime ---------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# Origins allowed to call the API from another site (CORS). The widget on this
# server is same-origin and does not need an entry.
IRUSHY_ALLOWED_ORIGINS=https://tnhhsscta.com,https://www.tnhhsscta.com,http://localhost:8787

# Secret used to sign IRUSHY session cookies (role/permission proof).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty, a random per-boot secret is generated (sessions reset on restart).
IRUSHY_SESSION_SECRET=

# ---- Limits ----------------------------------------------------------------
IRUSHY_MAX_INPUT_CHARS=2000         # max characters accepted per message
IRUSHY_MAX_HISTORY_MESSAGES=8       # bounded conversation history
IRUSHY_MAX_HISTORY_CHARS=6000
IRUSHY_MAX_ANSWER_CHARS=2400        # hard cap on an answer
IRUSHY_RATE_LIMIT_WINDOW_MS=300000  # 5 minutes
# Chat requests per window per IP. Default 60 for the local engine, 30 for
# IRUSHY_ENGINE=ollama, 20 for IRUSHY_ENGINE=apinex. A whole school lab
# behind one address shares this.
# IRUSHY_RATE_LIMIT_MAX=60
IRUSHY_MAX_CONCURRENT=2             # answers prepared at the same time
IRUSHY_BODY_LIMIT_KB=32

# ---- Content switches ------------------------------------------------------
# Sample content (data/sample/*.json and the sample-unapproved concept notes in
# data/knowledge/concepts.json) is ALWAYS labelled in the answer and in the API
# response. Default: on outside production, off in production.
IRUSHY_ALLOW_SAMPLE_CONTENT=true

# Shared secret with the test backend (the ASP/DB side) proving that an
# assessed test has been completed and returned. The widget can never assert
# this itself. While this is empty, IRUSHY treats every test as still active
# and declines to discuss answers - the safe default.
#   token = base64url(JSON({studentRef, testId, status, completedAt,
#                           anonymousPermitted?})) + "." +
#           base64url(HMAC-SHA256(body, this secret))
IRUSHY_ASSESSMENT_SECRET=

# Student results need authenticated, server-enforced teacher -> student
# permissions. None exist yet, so results are UNAVAILABLE (HTTP 503) whatever
# this says, and a record is never simulated. See docs/STATUS.md.
IRUSHY_ENABLE_STUDENT_RESULTS=false

# Demo teacher sign-in, ONLY for local permission testing. Leave false in
# production: there is no real teacher account store yet.
IRUSHY_ENABLE_DEMO_LOGIN=false
IRUSHY_DEMO_TEACHER_USER=
IRUSHY_DEMO_TEACHER_PASS=

# Transcripts are NOT stored. Logs carry counters only, never message bodies,
# unless this is set to true (and even then secrets are redacted).
IRUSHY_LOG_LEVEL=info
IRUSHY_LOG_MESSAGE_BODIES=false

# ---- Optional APInex backend (read only when IRUSHY_ENGINE=apinex) ----------
# Nothing below changes the default behaviour. IRUSHY never falls back to this
# backend on its own, and never switches to a paid model.
APINEX_BASE_URL=https://api.apinex.bond/v1
APINEX_MODEL=free/gemini-3.8-flash
# Your APInex key (starts with sk-apx...). Server-side ONLY. With
# IRUSHY_ENGINE=apinex and no key, chat answers "IRUSHY is not connected yet."
APINEX_API_KEY=sk-apx-REPLACE_ME
# Must stay false: when the model is unavailable IRUSHY reports the error
# instead of spending money on another model.
IRUSHY_ALLOW_MODEL_FALLBACK=false
# APINEX_FALLBACK_MODEL=
IRUSHY_PROVIDER_RPM=5               # APInex free tier; applies to this backend only

# ---- Optional Ollama backend (read only when IRUSHY_ENGINE=ollama) ----------
# A model running on THIS machine through Ollama (https://ollama.com): no key,
# no account. Install Ollama, pull a model (for example: ollama pull llama3.2),
# then set IRUSHY_ENGINE=ollama and OLLAMA_MODEL, and run npm run verify:ollama.
# Nothing below changes the default behaviour. IRUSHY never falls back to this
# backend, never switches models, and never falls back to another engine when
# Ollama fails. These lines are commented out on purpose.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2               # example: use a name from "ollama list"
# Another machine (a LAN box, a docker service) or an Ollama cloud model (a
# name ending in "cloud") sends visitors' questions off this server. IRUSHY
# refuses to start with either unless this is true.
# IRUSHY_OLLAMA_ALLOW_REMOTE=false
# Context window in tokens. Empty: the Ollama server's own setting.
# OLLAMA_NUM_CTX=

# ---- Shared by the optional backends (apinex, ollama) ----------------------
IRUSHY_MAX_OUTPUT_TOKENS=700        # hard cap on model output tokens
IRUSHY_REQUEST_TIMEOUT_MS=30000     # per model call (the widget waits 60 s)
IRUSHY_MAX_PROVIDER_RETRIES=1       # bounded retry for 429/502/503/504 only
